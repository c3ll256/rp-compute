{
  "schemaVersion": 1,
  "title": "Pi 4B integrated power, Sharp display and swappable GPIO baseboard",
  "manufacturing": {
    "name": "prototype-4layer-fr4-2oz-outer",
    "layers": 4,
    "copperThicknessOz": {
      "outer": 2,
      "inner": 1
    },
    "finishedThicknessMm": 1.6,
    "defaultTraceWidthMm": 0.3,
    "absoluteMinimumTraceWidthMm": 0.2,
    "absoluteMinimumCopperClearanceMm": 0.15,
    "preferredRoutingClearanceMm": 0.25,
    "copperToBoardEdgeMm": 0.3,
    "via": {
      "diameterMm": 0.6,
      "drillMm": 0.3
    },
    "waveSolderVia": {
      "diameterMm": 0.8,
      "drillMm": 0.4
    }
  },
  "netClasses": {
    "signal": {
      "nominalWidthMm": 0.3,
      "minimumWidthMm": 0.25,
      "clearanceMm": 0.25
    },
    "cpu_io": {
      "nominalWidthMm": 0.25,
      "minimumWidthMm": 0.25,
      "clearanceMm": 0.25
    },
    "power": {
      "nominalWidthMm": 0.5,
      "minimumWidthMm": 0.25,
      "clearanceMm": 0.25
    },
    "high_current": {
      "nominalWidthMm": 1.2,
      "minimumWidthMm": 0.75,
      "clearanceMm": 0.25
    },
    "ground": {
      "nominalWidthMm": 0.5,
      "minimumWidthMm": 0.25,
      "clearanceMm": 0.25
    },
    "sensitive_analog": {
      "nominalWidthMm": 0.3,
      "minimumWidthMm": 0.25,
      "clearanceMm": 0.25
    },
    "clock_high_speed": {
      "nominalWidthMm": 0.3,
      "minimumWidthMm": 0.25,
      "clearanceMm": 0.25
    },
    "differential_pair": {
      "nominalWidthMm": 0.25,
      "minimumWidthMm": 0.2,
      "clearanceMm": 0.25
    }
  },
  "nets": {
    "GND": { "class": "ground" },
    "V5_PI": {
      "class": "high_current",
      "currentCapacity": {
        "currentA": 3.2,
        "copperThicknessOz": 2,
        "maxTemperatureRiseC": 10,
        "requiredWidthMm": 0.75,
        "calculationMethod": "IPC-2221 external trace estimate",
        "rationale": "I=0.048*(10C)^0.44*A^0.725 gives about 81 mil^2; at nominal 2oz (2.756 mil) this is 0.747mm. Use 1.2mm nominal and validate actual copper, vias, losses and temperature."
      }
    },
    "V3V3_PI": { "class": "power" },
    "V5_LCD": { "class": "power" },
    "AUX_3V3": { "class": "power" },
    "GPIO2": { "class": "cpu_io" },
    "GPIO3": { "class": "cpu_io" },
    "GPIO5": { "class": "cpu_io" },
    "GPIO6": { "class": "cpu_io" },
    "GPIO7": { "class": "cpu_io" },
    "GPIO9": { "class": "cpu_io" },
    "GPIO10": { "class": "cpu_io" },
    "GPIO11": { "class": "cpu_io" },
    "GPIO13": { "class": "cpu_io" },
    "GPIO16": { "class": "cpu_io" },
    "GPIO19": { "class": "cpu_io" },
    "GPIO20": { "class": "cpu_io" },
    "GPIO21": { "class": "cpu_io" }
  },
  "footprintExceptions": [],
  "copperPours": {
    "enabled": true,
    "groundLayers": [
      "inner1",
      "inner2"
    ],
    "clearanceMm": 0.3,
    "padMarginMm": 0.3,
    "traceMarginMm": 0.3,
    "boardEdgeMarginMm": 0.3,
    "cutoutMarginMm": 0.5,
    "removeIslands": true
  },
  "stitchingVias": [],
  "keepouts": [],
  "allowedOverlaps": [],
  "allowedViaInPadComponents": [],
  "pcbRuleExceptions": [],
  "componentOrientations": [],
  "bomBindings": [
    { "bomItemId": "gpio_dock", "designators": ["J_PI"], "populate": true },
    { "bomItemId": "display_fpc", "designators": ["J_LCD"], "populate": true },
    { "bomItemId": "front_module_header", "designators": ["J_MOD"], "populate": true }
  ]
}
