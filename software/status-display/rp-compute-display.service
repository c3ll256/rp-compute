[Unit]
Description=rp-compute status and animated companion
DefaultDependencies=no
After=systemd-remount-fs.service systemd-modules-load.service systemd-udevd.service
RequiresMountsFor=/opt/rp-compute/software/status-display /tmp
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
RuntimeDirectory=rp-compute
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/rp-compute/software/status-display
ExecStartPre=/bin/sh /opt/rp-compute/software/status-display/prepare_display.sh
ExecStart=/usr/bin/python3 /opt/rp-compute/software/status-display/status_display.py --fps 60 --boot-seconds 4 --terminal-user xonar
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=sysinit.target
