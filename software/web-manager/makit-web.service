[Unit]
Description=Makit Compute local web management
After=network.target
RequiresMountsFor=/opt/rp-compute/software/web-manager /home/xonar

[Service]
Type=simple
User=xonar
Group=xonar
WorkingDirectory=/opt/rp-compute/software/web-manager
ExecStart=/bin/bash -lc 'exec /usr/bin/python3 /opt/rp-compute/software/web-manager/server.py --port 8080'
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
